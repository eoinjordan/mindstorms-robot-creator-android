<!--
  Robot Inventor Hub icon — white silhouette on transparent.
  Hub body + display + A/B buttons + status LED.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Hub body: rounded rectangle landscape -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M18,36 L90,36 Q96,36 96,42 L96,72 Q96,78 90,78 L18,78 Q12,78 12,72 L12,42 Q12,36 18,36 Z" />

    <!-- Display screen cutout in teal -->
    <path
        android:fillColor="#006A6A"
        android:pathData="M34,43 L74,43 Q77,43 77,46 L77,68 Q77,71 74,71 L34,71 Q31,71 31,68 L31,46 Q31,43 34,43 Z" />

    <!-- Screen pixel art: hub face (4 dots = eyes + mouth) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M41,51 h4 v4 h-4 z M63,51 h4 v4 h-4 z M44,61 h20 v3 h-20 z" />

    <!-- Left A button -->
    <path
        android:fillColor="#CCCCCC"
        android:pathData="M16,50 Q12,50 12,54 L12,62 Q12,66 16,66 L18,66 L18,50 Z" />

    <!-- Right B button -->
    <path
        android:fillColor="#CCCCCC"
        android:pathData="M90,50 Q96,50 96,54 L96,62 Q96,66 90,66 L88,66 L88,50 Z" />

    <!-- Status LED (top-left, teal) -->
    <path
        android:fillColor="#00CCCC"
        android:pathData="M20,38 m0,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />

    <!-- USB port indicator (bottom center) -->
    <path
        android:fillColor="#BBBBBB"
        android:pathData="M50,74 h8 v3 h-8 z" />
</vector>